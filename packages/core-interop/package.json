{
  "name": "@itwin/presentation-core-interop",
  "version": "2.0.0-alpha.4",
  "description": "The package acts as a layer between iTwin.js Core and Presentation packages.",
  "license": "MIT",
  "author": {
    "name": "Bentley Systems, Inc.",
    "url": "http://www.bentley.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iTwin/presentation.git",
    "directory": "packages/core-interop"
  },
  "keywords": [
    "Bentley",
    "iModel",
    "iTwin.js",
    "Presentation"
  ],
  "type": "module",
  "types": "lib/presentation-core-interop",
  "module": "lib/presentation-core-interop.js",
  "exports": {
    ".": {
      "import": "./lib/presentation-core-interop.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run -s typecheck && npm run -s build:lib",
    "build:lib": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf lib",
    "cover": "vitest run --coverage",
    "lint": "eslint \"./src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "extract-api": "betools extract-api --entry=lib/presentation-core-interop --apiReportFolder=./api --apiReportTempFolder=./api/temp --apiSummaryFolder=./api --includeUnexportedApis",
    "check-internal": "node ../../scripts/checkInternal.js --apiSummary ./api/presentation-core-interop.api.md",
    "update-extractions": "node ../../scripts/updateExtractions.js --targets=./README.md",
    "check-extractions": "node ../../scripts/updateExtractions.js --targets=./README.md --check",
    "validate-markdowns": "node ../../scripts/validateMarkdowns.js README.md"
  },
  "dependencies": {
    "@itwin/presentation-shared": "workspace:*",
    "rxjs": "catalog:rxjs"
  },
  "peerDependencies": {
    "@itwin/core-bentley": "^5.12.0",
    "@itwin/core-common": "^5.12.0",
    "@itwin/core-geometry": "^5.12.0",
    "@itwin/core-quantity": "^5.12.0",
    "@itwin/ecschema-metadata": "^5.12.0"
  },
  "devDependencies": {
    "@itwin/build-tools": "catalog:build-tools",
    "@itwin/core-bentley": "catalog:itwinjs-core-dev",
    "@itwin/core-common": "catalog:itwinjs-core-dev",
    "@itwin/core-geometry": "catalog:itwinjs-core-dev",
    "@itwin/core-quantity": "catalog:itwinjs-core-dev",
    "@itwin/ecschema-metadata": "catalog:itwinjs-core-dev",
    "@itwin/eslint-plugin": "catalog:build-tools",
    "@vitest/coverage-v8": "catalog:test-tools",
    "cpx2": "catalog:build-tools",
    "eslint": "catalog:build-tools",
    "rimraf": "catalog:build-tools",
    "rxjs-for-await": "catalog:rxjs",
    "@typescript/native": "catalog:build-tools",
    "typescript": "catalog:build-tools",
    "vitest": "catalog:test-tools"
  }
}
