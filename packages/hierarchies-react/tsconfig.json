{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "sourceMap": true,
    "esModuleInterop": true,
    "inlineSources": true,
    "declaration": true,
    "declarationMap": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "noEmit": true,
    "types": ["@stratakit/mui/types.d.ts"]
  },
  "include": ["src", "types.d.ts", "tsdown.config.ts", "vitest.config.ts"]
}
