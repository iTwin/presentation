  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "npm run -s build:lib",
    "build:lib": "tsc -p tsconfig.lib.json",
    "clean": "rimraf lib temp",
    "lint": "eslint \"./src/**/*.ts\""
  },
  "type": "module",
  "types": "lib/presentation-test-utilities",
