{
  "name": "@itwin/presentation-content-react",
  "version": "0.1.0",
  "private": true,
  "description": "React hooks for working with @itwin/presentation-content",
  "license": "MIT",
  "author": {
    "name": "Bentley Systems, Inc.",
    "url": "http://www.bentley.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iTwin/presentation.git",
    "directory": "packages/content-react"
  },
  "keywords": [
    "Bentley",
    "Content",
    "iModel",
    "iTwin.js",
    "Presentation",
    "Properties",
    "React"
  ],
  "type": "module",
  "main": "lib/presentation-content-react.js",
  "types": "lib/presentation-content-react.d.ts",
  "exports": {
    ".": "./lib/presentation-content-react.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run -s typecheck && tsc -p tsconfig.build.json",
    "clean": "rimraf lib",
    "extract-api": "betools extract-api --entry=lib/presentation-content-react --apiReportFolder=./api --apiReportTempFolder=./api/temp --apiSummaryFolder=./api --includeUnexportedApis",
    "lint": "eslint \"./src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@itwin/presentation-content": "workspace:*",
    "@itwin/presentation-shared": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@itwin/build-tools": "catalog:build-tools",
    "@itwin/eslint-plugin": "catalog:build-tools",
    "@types/react": "catalog:react",
    "@testing-library/react": "catalog:test-tools",
    "eslint": "catalog:build-tools",
    "eslint-plugin-react": "catalog:build-tools",
    "happy-dom": "catalog:test-tools",
    "react": "catalog:react",
    "rimraf": "catalog:build-tools",
    "@typescript/native": "catalog:build-tools",
    "typescript": "catalog:build-tools",
    "vitest": "catalog:test-tools"
  }
}
