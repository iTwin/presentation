{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true,
    "denyWarnings": true
  },
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["**/lib/**", "**/build/**"],
  "rules": {
    "import/no-duplicates": "error",
    "no-shadow": ["error", { "hoist": "all", "allow": ["T", "args"] }],
    "no-redeclare": "error",
    "no-unused-expressions": ["error", { "allowShortCircuit": true, "allowTernary": true }],
    "typescript/no-deprecated": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/promise-function-async": "error",
    "no-unused-vars": [
      "error",
      {
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_"
      }
    ],
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/only-throw-error": "error",
    "typescript/no-unnecessary-condition": ["error", { "allowConstantLoopConditions": "only-allowed-literals" }],
    "typescript/explicit-member-accessibility": [
      "error",
      { "accessibility": "explicit", "overrides": { "constructors": "off" } }
    ],
    "typescript/no-empty-object-type": ["error", { "allowObjectTypes": "always" }]
  },
  "overrides": [
    // Packages and apps that use React
    {
      "files": [
        "packages/components/**",
        "packages/content-react/**",
        "packages/hierarchies-react/**",
        "packages/unified-selection-react/**",
        "apps/full-stack-tests/**",
        "apps/test-app/frontend/**"
      ],
      "plugins": ["react"],
      "rules": {
        "react/rules-of-hooks": "error",
        "react/unsupported-syntax": "error"
      }
    },
    {
      "files": ["packages/**"],
      "rules": {
        "no-console": "error"
      }
    },
    {
      "files": ["**/learning-snippets/**"],
      "rules": {
        "import/no-duplicates": "off",
        "typescript/consistent-type-imports": "off"
      }
    },
    {
      "files": ["**/src/test/**", "**/*.test.ts", "**/*.test.tsx", "packages/test-utilities/**"],
      "rules": {
        "typescript/unbound-method": "off",
        "typescript/require-array-sort-compare": "off",
        "no-unsafe-optional-chaining": "off",
        "require-yield": "off"
      }
    }
  ]
}
