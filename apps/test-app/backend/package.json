{
  "name": "@test-app/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --inspect --max-http-header-size=16000 ./lib/main.js",
    "start:electron": "cross-env NODE_ENV=development electron ./lib/main.js",
    "build": "tsc",
    "clean": "rimraf lib build",
    "lint": "oxlint src",
    "lint:no-internal": "eslint \"./src/**/*.ts\"",
    "docs": "betools extract --fileExt=ts --extractFrom=./src --recursive --out=./build/docs/extract"
  },
  "devDependencies": {
    "@itwin/build-tools": "catalog:build-tools",
    "@itwin/core-backend": "catalog:itwinjs-core-dev",
    "@itwin/core-bentley": "catalog:itwinjs-core-dev",
    "@itwin/core-common": "catalog:itwinjs-core-dev",
    "@itwin/core-electron": "catalog:itwinjs-core-dev",
    "@itwin/ecschema-rpcinterface-impl": "catalog:itwinjs-core-dev",
    "@itwin/express-server": "catalog:itwinjs-core-dev",
    "@itwin/presentation-backend": "catalog:itwinjs-core-dev",
    "@itwin/presentation-opentelemetry": "workspace:*",
    "@opentelemetry/api": "catalog:opentelemetry",
    "@opentelemetry/resources": "catalog:opentelemetry",
    "@opentelemetry/sdk-node": "catalog:opentelemetry",
    "@opentelemetry/sdk-trace": "catalog:opentelemetry",
    "@opentelemetry/semantic-conventions": "catalog:opentelemetry",
    "@test-app/common": "workspace:*",
    "@typescript/native": "catalog:build-tools",
    "cross-env": "catalog:build-tools",
    "electron": "^43.8.3",
    "rimraf": "catalog:build-tools",
    "typescript": "catalog:build-tools"
  }
}
